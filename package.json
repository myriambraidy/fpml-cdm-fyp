{
  "name": "fpml-cdm-copilot",
  "version": "0.1.0",
  "type": "module",
  "description": "AI-powered FPML to CDM mapping copilot with agentic skills",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "compile": "bun build --compile src/index.ts --outfile fpml-copilot",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:skills": "bun test test/skills/"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.20.0",
    "@hono/zod-openapi": "^0.16.0",
    "better-sqlite3": "^11.0.0",
    "fast-xml-parser": "^4.3.6",
    "hono": "^4.3.0",
    "zod": "^3.23.0",
    "zod-to-json-schema": "^3.23.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/better-sqlite3": "^7.6.10"
  }
}
