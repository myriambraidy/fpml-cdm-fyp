{
  "name": "fpml-cdm-copilot",
  "version": "0.1.0",
  "type": "module",
  "description": "AI-powered FPML to CDM mapping copilot with agentic skills",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "compile": "bun build --compile src/index.ts --outfile fpml-copilot",
    "typecheck": "node ./node_modules/typescript/lib/tsc.js --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:skills": "bun test test/skills/",
    "test:agent": "bun test test/agent/",
    "test:api": "bun test test/api/",
    "test:cookbook": "bun test test/cookbook/",
    "test:cookbook-llm": "bun test test/cookbook-llm/",
    "agent:harness": "bun scripts/run-agent.ts",
    "draft:run": "bun scripts/run-draft-phase.ts",
    "cookbook:run": "bun scripts/run-cookbook-phase.ts",
    "cookbook:llm": "bun scripts/run-cookbook-llm-phase.ts",
    "fetch:cdm-json": "bun scripts/fetch-cdm-json.ts",
    "fetch:rosetta-source": "bun scripts/data-web-scraping/fetch-rosetta-source.ts",
    "index:rosetta-source": "bun scripts/data-web-scraping/index-rosetta-source.ts",
    "docs:rosetta-source": "bun scripts/data-web-scraping/build-rosetta-docpacks.ts",
    "preflight:cdm-rosetta-java": "bun scripts/preflight-cdm-rosetta-java.ts",
    "rosetta:build": "cd rosetta-validator && mvn -q -DskipTests package",
    "rosetta:preflight": "bun scripts/preflight-cdm-rosetta-java.ts",
    "build:cdm-parallel": "bun scripts/build-cdm-parallel.ts",
    "java-agent:run": "bun scripts/run-java-generator-agent.ts"
  },
  "dependencies": {
    "@hono/zod-openapi": "^0.16.0",
    "ajv": "^8.18.0",
    "ajv-draft-04": "^1.0.0",
    "fast-xml-parser": "^4.3.6",
    "hono": "^4.3.0",
    "zod": "^3.23.0",
    "zod-to-json-schema": "^3.23.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0"
  }
}
