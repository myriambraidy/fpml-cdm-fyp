PORT=3000
DB_PATH=./data/app.db
ANALYST_EMAIL=analyst@localhost
UPLOAD_MAX_BYTES=10000000
REVIEW_CONFIDENCE_THRESHOLD=60
AUTO_APPROVE_THRESHOLD=80
OPENROUTER_API_KEY=
OPENROUTER_MODEL=minimax/minimax-m2.7
DRAFT_MODEL=openai/gpt-5-mini
DRAFT_SYNTHESIS_MODEL=openai/gpt-5-mini
DRAFT_PAIR_MAX_TOKENS=3000
DRAFT_SYNTHESIS_MAX_TOKENS=5000
DRAFT_STORE_FAILED_RAW_RESPONSES=true
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=1
# OpenRouter HTTP 429 + transient 502/503/504: extra attempts after first failure (default 5).
LLM_HTTP_TRANSIENT_MAX_RETRIES=5
